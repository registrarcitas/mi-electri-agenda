<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<meta name="theme-color"
content="#0f172a">

<title>Mi Electri-Agenda</title>

<link rel="stylesheet"
href="styles.css">

</head>


<body>


<header>

<h1>⚡ Mi Electri-Agenda</h1>

<p>
Agenda · Presupuestos · Cobros
</p>

</header>


<main>


<!-- =====================
     INICIO
===================== -->

<section id="inicio">

<div class="card">

<h2>⚡ Mi Electri-Agenda</h2>

<p>
Tu herramienta para organizar
clientes, trabajos, presupuestos
y cobros.
</p>

</div>


<div class="menu">


<button onclick="mostrar('cotizador')">

🧾<br>
Nuevo<br>
presupuesto

</button>


<button onclick="mostrar('clientes')">

👥<br>
Clientes

</button>


<button onclick="mostrar('agenda')">

📅<br>
Agenda

</button>


<button onclick="mostrar('cobros')">

💰<br>
Cobros

</button>


<button onclick="mostrar('historial')">

📊<br>
Historial

</button>


<button onclick="mostrar('servicios')">

🔧<br>
Servicios

</button>


<button onclick="mostrar('materiales')">

📦<br>
Materiales

</button>


</div>

</section>



<!-- =====================
     CLIENTES
===================== -->

<section id="clientes"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>👥 Clientes</h2>


<button class="primary full"
onclick="nuevoCliente()">

+ Nuevo cliente

</button>

</div>


<div id="listaClientes"></div>


</section>



<!-- =====================
     SERVICIOS
===================== -->

<section id="servicios"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>🔧 Servicios</h2>


<input
id="servNombre"
placeholder="Nombre del servicio">


<input
id="servPrecio"
type="number"
placeholder="Precio de mano de obra">


<button
class="success full"
onclick="agregarServicio()">

+ Agregar servicio

</button>

</div>


<div id="listaServicios"></div>


</section>



<!-- =====================
     MATERIALES
===================== -->

<section id="materiales"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>📦 Materiales</h2>


<input
id="matNombre"
placeholder="Nombre del material">


<input
id="matCosto"
type="number"
placeholder="Costo de compra">


<input
id="matMargen"
type="number"
value="20"
placeholder="Margen %">


<button
class="success full"
onclick="agregarMaterialCatalogo()">

+ Agregar material

</button>

</div>


<div id="listaMateriales"></div>


</section>



<!-- =====================
     COTIZADOR
===================== -->

<section id="cotizador"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="total">

<small>
TOTAL DEL PRESUPUESTO
</small>

<strong id="total">
$0.00
</strong>

</div>



<!-- CLIENTE -->

<div class="card">

<h2>👤 Cliente</h2>


<select
id="clienteSeleccionado"
onchange="cargarClienteCotizacion()">

<option value="">
Seleccionar cliente
</option>

</select>


<div id="datosCliente"></div>

</div>



<!-- SERVICIO -->

<div class="card">

<h2>🔧 Agregar servicio</h2>


<select id="servicioSeleccionado">

<option value="">
Seleccionar servicio
</option>

</select>


<input
id="cantidadServicio"
type="number"
value="1"
min="1"
placeholder="Cantidad">


<button
class="primary full"
onclick="agregarServicioCotizacion()">

+ Agregar servicio

</button>

</div>



<!-- MATERIAL -->

<div class="card">

<h2>📦 Agregar material</h2>


<select
id="materialSeleccionado">

<option value="">
Seleccionar material
</option>

</select>


<input
id="cantidadMaterial"
type="number"
value="1"
min="1"
placeholder="Cantidad">


<button
class="primary full"
onclick="agregarMaterialCotizacion()">

+ Agregar material

</button>

</div>



<!-- CONCEPTOS -->

<div class="card">

<h2>🧾 Conceptos</h2>


<div id="conceptos">

<div class="empty">

No hay conceptos agregados.

</div>

</div>


<div class="summary">


<div>

<span>
Mano de obra
</span>

<strong id="subtotalServicios">
$0.00
</strong>

</div>


<div>

<span>
Materiales
</span>

<strong id="subtotalMateriales">
$0.00
</strong>

</div>


<div class="final">

<span>
TOTAL
</span>

<strong id="totalFinal">
$0.00
</strong>

</div>


</div>

</div>



<!-- PAGO -->

<div class="card">

<h2>💰 Pago</h2>


<input
id="anticipo"
type="number"
placeholder="Anticipo">


<div class="summary">


<div class="final">

<span>
Saldo
</span>

<strong id="saldo">
$0.00
</strong>

</div>


</div>

</div>


<button
class="success full"
onclick="guardarPresupuesto()">

💾 Guardar presupuesto

</button>


<button
class="dark full"
onclick="compartirWhatsApp()">

📲 Compartir por WhatsApp

</button>


</section>



<!-- =====================
     AGENDA
===================== -->

<section id="agenda"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>📅 Agenda</h2>

<p>
Trabajos programados
</p>

</div>


<div id="listaAgenda"></div>


</section>



<!-- =====================
     COBROS
===================== -->

<section id="cobros"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>💰 Cobros</h2>

<p>
Clientes con saldo pendiente
</p>

</div>


<div id="listaCobros"></div>


</section>



<!-- =====================
     HISTORIAL
===================== -->

<section id="historial"
class="hidden">


<button class="gray back"
onclick="mostrar('inicio')">

← Regresar

</button>


<div class="card">

<h2>📊 Historial</h2>

<p>
Presupuestos y movimientos
</p>

</div>


<div id="listaHistorial"></div>


</section>


</main>



<!-- =====================
     MENÚ INFERIOR
===================== -->

<nav>


<button onclick="mostrar('inicio')">

🏠<br>
Inicio

</button>


<button onclick="mostrar('clientes')">

👥<br>
Clientes

</button>


<button onclick="mostrar('cotizador')">

🧾<br>
Cotizar

</button>


<button onclick="mostrar('agenda')">

📅<br>
Agenda

</button>


<button onclick="mostrar('cobros')">

💰<br>
Cobros

</button>


</nav>



<!-- =====================
     JAVASCRIPT
===================== -->

<script src="app.js"></script>


</body>

</html>
